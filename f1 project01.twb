    <worksheet name='Driver Leaderboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#ffffff' fontname='arial bold' fontsize='14'>Top 10 drivers by cumulative points</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='race_results+ (F1 Racing Project Dataset)' name='federated.03q3kek08hpz8b11qvkx615b3z0r' />
          </datasources>
          <datasource-dependencies datasource='federated.03q3kek08hpz8b11qvkx615b3z0r'>
            <column caption='Driver (Championship!Standings)' datatype='string' name='[driver (championship!standings)]' role='dimension' type='nominal' />
            <column-instance column='[driver (championship!standings)]' derivation='None' name='[none:driver (championship!standings):nk]' pivot='key' type='nominal' />
            <column-instance column='[season (championship!standings)]' derivation='None' name='[none:season (championship!standings):qk]' pivot='key' type='quantitative' />
            <column caption='Points (Championship!Standings)' datatype='integer' name='[points (championship!standings)]' role='measure' type='quantitative' />
            <column caption='Season (Championship!Standings)' datatype='integer' name='[season (championship!standings)]' role='measure' type='ordinal' />
            <column-instance column='[points (championship!standings)]' derivation='Sum' name='[sum:points (championship!standings):qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.03q3kek08hpz8b11qvkx615b3z0r].[none:driver (championship!standings):nk]'>
