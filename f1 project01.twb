            <zone h='12362' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='99006' x='497' y='6120' />
            <zone h='80539' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='99006' x='497' y='18482'>
              <flipboard active-id='10' nav-type='caption' show-nav-arrows='true'>
                <story-points>
                  <story-point caption='Scene 1: The Race Command CenterScene&#10;An overview of Formula 1 performance, reliability, championship trends and race strategy from 2010 to 2026.' captured-sheet='Dashboard 1' id='1' />
                  <story-point caption='THE GLOBAL FOOTPRINT OF FORMULA 1&#10;Exploring the geographical distribution of Formula 1 Grand Prix racing across countries and circuits.' captured-sheet='Global Race Map.' id='2' />
                  <story-point caption='THE BATTLE FOR POINTS&#10;Comparing Formula 1 drivers through cumulative championship points across the selected seasons.' captured-sheet='Driver Leaderboard' id='3' />
                  <story-point caption='THE CONSTRUCTOR CHAMPIONSHIP BATTLE&#10;Comparing constructor performance and rankings to understand the competitive hierarchy of Formula 1 teams.' captured-sheet='Team Performance' id='4' />
                  <story-point caption='THE RISE AND FALL OF CHAMPIONS&#10;Tracking how Formula 1 constructors&apos; championship performance has evolved across the 2010–2026 seasons.' captured-sheet='Championship Trajectory' id='5' />
                  <story-point caption='THE COST OF NOT FINISHING&#10;Investigating driver retirements and their recorded causes, including collisions and mechanical failures.' captured-sheet='Driver Reliability.' id='6' />
                  <story-point caption='THE TYRE STRATEGY GAME&#10;Examining the distribution of tyre compounds and exploring their role in Formula 1 race strategy.' captured-sheet='Tyre Strategy Analysis' id='7' />
                  <story-point caption='THE STRATEGY BEHIND EVERY LAP&#10;Exploring lap-level performance and pit-stop patterns to understand the strategic decisions made during races.' captured-sheet='Lap Strategy &amp; Pit Stops' id='8' />
                  <story-point caption='NATIONS OF GRAND PRIX RACING&#10;Discovering the countries represented in Formula 1 and examining the geographical distribution of Grand Prix participation.' captured-sheet='Country Participation' id='9' />
                  <story-point caption='THE LEGACY OF THE PODIUM&#10;Celebrating podium achievements and exploring the success of Formula 1 drivers and constructors.' captured-sheet='Podium Achievements' id='10' />
                </story-points>
              </flipboard>
            </zone>
          </zone>
